<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:colorAccent">#FF8B5CF6</item>
        <item name="android:statusBarColor">#FF1E1E1E</item>
        <item name="android:navigationBarColor">#FF1E1E1E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#FFE8EAF6</item>
    </style>

    <style name="SheetTheme" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="FullDialogTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF121212</item>
        <item name="android:statusBarColor">#FF1E1E1E</item>
        <item name="android:navigationBarColor">#FF1E1E1E</item>
    </style>
</resources>
